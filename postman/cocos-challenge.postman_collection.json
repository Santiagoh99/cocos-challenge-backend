              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"status REJECTED\", () => pm.expect(pm.response.json().status).to.eql(\"REJECTED\"));"
                ]
