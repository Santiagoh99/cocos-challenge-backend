        {
          "name": "Portfolio - usuario con órdenes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/1/portfolio",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "1",
                "portfolio"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
